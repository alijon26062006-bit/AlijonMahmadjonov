# Скопируйте в .env и заполните. Файл .env НИКОГДА не коммитить.

# База данных PostgreSQL
DATABASE_URL=postgresql+psycopg://shop:CHANGE_ME@localhost:5432/shop

# Секрет для подписи сессий: длинная случайная строка
# сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# API поставщика (ключ fc_… из профиля поставщика)
SUPPLIER_API_URL=https://api.fzr.cards
SUPPLIER_API_KEY=

# Наценка по умолчанию, % (потом меняется в админке)
DEFAULT_MARKUP_PERCENT=10

# Почты администраторов через запятую (получают роль admin при регистрации)
ADMIN_EMAILS=

# Адреса сайта, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# true на боевом сервере с HTTPS
COOKIE_SECURE=false
