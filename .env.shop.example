# ═══════════════════════════════════════════════════════════════════
#  Бот-магазин ALMAZ TJ — настройки
#  cp .env.shop.example .env  →  заполнить  →  bash start_shop.sh
# ═══════════════════════════════════════════════════════════════════

# ── Обязательное ───────────────────────────────────────────────────
SHOP_BOT_TOKEN=токен_от_BotFather
SHOP_ADMIN_IDS=ваш_telegram_id

# ── FireLoot (автовыдача заказов) ──────────────────────────────────
# fireloot — заказы уходят в API сами; manual — всё вручную через админку
SHOP_SUPPLIER=fireloot
SHOP_SUPPLIER_URL=https://partner.firelootshop.com/api/v1
SHOP_SUPPLIER_KEY=ключ_FireLoot

# ── Реквизиты пополнения ───────────────────────────────────────────
SHOP_CARD_NUMBER=9762000109866409
SHOP_CARD_HOLDER=ALIJON M.
SHOP_ALIF_ACCOUNT=939880805

# Ссылки с автозаполнением. Подстановки:
#   {card} {amount} {amount_int} {diram} {comment} {account}
SHOP_PAY_LINK=http://pay.dc.tj/?A={card}&s={amount}&c={comment}&f1=133&FIELD2=&FIELD3=
SHOP_ALIF_LINK=https://alifmobi.page.link/providers?id=124&amount={amount}&account={account}

# ── Контакты ───────────────────────────────────────────────────────
SHOP_SUPPORT=ваш_username_без_собаки
SHOP_REVIEWS_URL=https://t.me/almaz_tj_official

# ── Лимиты пополнения (в дирамах: 1000 = 10.00 с.) ─────────────────
SHOP_MIN_TOPUP=1000
SHOP_MAX_TOPUP=500000

# ── Внешний вид ────────────────────────────────────────────────────
# Цветные кнопки (зелёные/красные/синие). Поставьте 0, если у кого-то
# из покупателей старый Telegram и цвета мешают.
SHOP_BUTTON_COLORS=1

# ── Прочее ─────────────────────────────────────────────────────────
SHOP_CURRENCY=с.
SHOP_DATA_DIR=data
SHOP_DB_NAME=shop.sqlite3
SHOP_LOG_LEVEL=INFO
