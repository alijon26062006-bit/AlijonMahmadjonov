# ═══════════════════════════════════════════════════════════════════
#  Бот-магазин: Telegram Stars / Premium, Free Fire, PUBG Mobile
#  Скопируй в .env и заполни своими данными.
# ═══════════════════════════════════════════════════════════════════

# ── Обязательное ───────────────────────────────────────────────────
# Токен бота у @BotFather → /newbot
SHOP_BOT_TOKEN=123456789:AAAA-BBBB-CCCC

# Твой Telegram ID (узнать: напиши боту /id). Через запятую, если админов несколько.
SHOP_ADMIN_IDS=123456789

# ── Реквизиты для пополнения ───────────────────────────────────────
SHOP_CARD_NUMBER=8888 1234 1234 1234
SHOP_CARD_HOLDER=ALIJON M.

# Ссылка «Душанбе Сити» с автозаполнением.
# Доступные подстановки:
#   {card}       — номер карты без пробелов
#   {amount}     — сумма с точкой, например 150.00
#   {amount_int} — сумма целым числом сомони
#   {diram}      — сумма в дирамах
#   {comment}    — 4-значный код подтверждения
# Оставь пустым, пока не пришлёшь свой шаблон — тогда бот просто покажет реквизиты.
SHOP_PAY_LINK=

# ── Контакты ───────────────────────────────────────────────────────
SHOP_SUPPORT=your_username
SHOP_REVIEWS_URL=https://t.me/your_reviews_channel
SHOP_CHANNEL_URL=

# ── Лимиты пополнения (в дирамах: 1000 = 10.00 с.) ─────────────────
SHOP_MIN_TOPUP=1000
SHOP_MAX_TOPUP=500000

# ── API поставщика ─────────────────────────────────────────────────
# manual — заказы выполняет админ вручную (работает прямо сейчас)
# http   — через API поставщика (включить, когда пришлёшь ключ и документацию)
SHOP_SUPPLIER=manual
SHOP_SUPPLIER_URL=
SHOP_SUPPLIER_KEY=

# ── Прочее ─────────────────────────────────────────────────────────
SHOP_CURRENCY=с.
SHOP_DATA_DIR=data
SHOP_DB_NAME=shop.sqlite3
SHOP_LOG_LEVEL=INFO
