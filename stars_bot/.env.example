# ---------- Telegram ----------
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# ID админов через запятую (свой ID узнать у @userinfobot)
ADMIN_IDS=123456789

# Канал/чат, куда дублируются заявки (необязательно). Бот должен быть там админом.
ORDERS_CHAT_ID=

# ---------- Реквизиты для оплаты ----------
PAYMENT_CARD_NUMBER=8600 1234 5678 9012
PAYMENT_CARD_HOLDER=ALIJON M.
PAYMENT_BANK=Uzcard / Humo
CURRENCY=UZS

# ---------- Fragment ----------
# mock   — ничего никуда не отправляет, только пишет в лог (для разработки)
# api    — реальная доставка через Fragment
FRAGMENT_MODE=mock

FRAGMENT_BASE_URL=https://api.fragment.com
FRAGMENT_API_KEY=
FRAGMENT_PHONE_NUMBER=
# Мнемоника TON-кошелька: 24 слова через пробел. НИКОГДА не коммить в git.
FRAGMENT_MNEMONICS=

# ---------- Прочее ----------
DB_PATH=data/bot.sqlite3
SUPPORT_USERNAME=AlijonMahmadjonov
LOG_LEVEL=INFO
