# ================= Telegram =================
# Токен от @BotFather
BOT_TOKEN=123456:AA...

# Твой Telegram ID (узнать у @userinfobot). Несколько — через запятую.
ADMIN_IDS=123456789

# Чат/канал для дублирования заявок (необязательно). Бот должен быть там админом.
ORDERS_CHAT_ID=

# Юзернейм бота без @ (для реферальных ссылок). Пусто — определится сам.
BOT_USERNAME=

# ================= Деньги =================
CURRENCY=с.

# Цена одной звезды в ДИРАМАХ (1 сомони = 100 дирам).
# 20 = 0.20 сомони за звезду. Ставь свою с наценкой.
STAR_PRICE_DIRAM=20

MIN_STARS=50
MAX_STARS=10000

# Минимальное пополнение в дирамах: 1000 = 10.00 сомони
MIN_DEPOSIT_DIRAM=1000

# Процент рефералу с каждого пополнения приглашённого
REFERRAL_PERCENT=5

# ================= Реквизиты (Душанбе) =================
PAY_CARD_NUMBER=0000 0000 0000 0000
PAY_CARD_HOLDER=ALIJON M.
PAY_CARD_BANK=Амонатбонк
PAY_CITY=Душанбе
# Доп. строка под реквизитами: комментарий к переводу, время работы и т.п.
PAY_EXTRA=⚠️ Переводите точную сумму — иначе заявку придётся проверять вручную.

# Кнопка быстрой оплаты в приложении «Душанбе Сити» (необязательно).
# Номер счёта — параметр a= из вашей ссылки pay.dc.tj
DC_ACCOUNT=
# Подпись в комментарии к переводу, например @uwayscoder
DC_COMMENT=
# Код услуги — параметр f1= из ссылки, обычно 133
DC_SERVICE=133

# ================= Выдача звёзд =================
# mock    — ничего не отправляет, только пишет в лог (для тестов)
# fazer   — api.fzr.cards. Пополняете баланс реселлера один раз, дальше
#           бот списывает сам. Сид-фраза не нужна.
# mystars — api.mystars.tg. Сид-фраза сервису НЕ передаётся: счёт на
#           оплату приходит вам в Telegram, платите в один тап.
# api     — apifragment.online. Работает без вашего участия, но сервис
#           хранит вашу сид-фразу у себя и имеет полный доступ к кошельку.
FRAGMENT_MODE=mock

# ---- FazerCards (FRAGMENT_MODE=fazer) ----
# Ключ начинается с fc_
FAZER_API_KEY=
FAZER_BASE_URL=https://api.fzr.cards
# Пути из разделов Orders и Account документации — сверьте перед запуском.
FAZER_ORDER_PATH=/api/v2/orders/{order_id}
FAZER_BALANCE_PATH=/api/v2/account

# ---- MyStars (FRAGMENT_MODE=mystars) ----
# Ключ выдают в @my_stars_tg_bot: раздел API access.
MYSTARS_API_KEY=
MYSTARS_BASE_URL=https://api.mystars.tg/v1
# ton или usdt_ton
MYSTARS_CURRENCY=ton
# Сколько ждать оплату и доставку, секунды
MYSTARS_WAIT_TIMEOUT=1800

# ---- ApiFragment (FRAGMENT_MODE=api) ----

FRAGMENT_BASE_URL=https://apifragment.online
FRAGMENT_API_KEY=

# Сид-фраза TON-кошелька, 24 слова через пробел.
#
# ВНИМАНИЕ: сервис хранит её у себя, чтобы входить на Fragment от вашего
# имени. Технически это даёт ему полный доступ к кошельку. Используйте
# ОТДЕЛЬНЫЙ кошелёк с оборотной суммой, а не основной.
FRAGMENT_WALLET_SEED=

# Чем платить на Fragment: ton или usdt_ton
FRAGMENT_PAYMENT_METHOD=ton

# Заказ выполняется асинхронно — как долго ждать результат (секунды)
TASK_POLL_INTERVAL=3
TASK_POLL_TIMEOUT=300

# ================= Ссылки =================
SUPPORT_USERNAME=AlijonMahmadjonov
REVIEWS_URL=
NEWS_URL=

# ================= Прочее =================
DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
