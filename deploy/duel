#!/usr/bin/env bash
# Управление математической дуэлью одной командой.
#
#   duel          — что сейчас происходит
#   duel logs     — смотреть журнал вживую
#   duel restart  — перезапустить
#   duel update   — забрать свежий код и перезапустить
#
set -euo pipefail

HOME_DIR="${DUEL_HOME:-/opt/duel}"
PORT="${DUEL_PORT:-8081}"

# Почти всё требует прав администратора — попросим их сами, а не будем ругаться.
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
  exec sudo -E "$0" "$@"
fi

BOLD=$'\033[1m'; DIM=$'\033[90m'; GREEN=$'\033[32m'; RED=$'\033[31m'; OFF=$'\033[0m'

health() {
  local body
  if body="$(curl -fsS --max-time 5 "http://127.0.0.1:${PORT}/health" 2>/dev/null)"; then
    printf '  %s✓%s сервер отвечает: %s\n' "$GREEN" "$OFF" "$body"
  else
    printf '  %s✗%s сервер не отвечает на порту %s\n' "$RED" "$OFF" "$PORT"
    printf '  %sПосмотри, что случилось: duel logs%s\n' "$DIM" "$OFF"
    return 1
  fi
}

case "${1:-status}" in
  status)
    systemctl status duel --no-pager -l | head -n 12
    echo
    health || true
    ;;
  logs)
    journalctl -u duel -n 100 -f
    ;;
  start|stop|restart)
    systemctl "$1" duel
    [ "$1" = "stop" ] || { sleep 2; health; }
    printf '%sГотово: %s%s\n' "$GREEN" "$1" "$OFF"
    ;;
  update)
    cd "$HOME_DIR"
    printf '%sЗабираю свежий код…%s\n' "$BOLD" "$OFF"
    git pull --ff-only
    .venv/bin/pip install --quiet --upgrade -r requirements-duel.txt
    systemctl restart duel
    sleep 2
    health
    ;;
  test)
    cd "$HOME_DIR"
    .venv/bin/python -c 'import pytest' 2>/dev/null \
      || .venv/bin/pip install --quiet pytest pytest-asyncio
    .venv/bin/python -m pytest -q tests/test_duel_*.py
    ;;
  *)
    cat <<'HELP'
Математическая дуэль

  duel            что сейчас происходит
  duel logs       журнал вживую (выход — Ctrl+C)
  duel restart    перезапустить
  duel stop       остановить
  duel start      запустить
  duel update     забрать свежий код и перезапустить
  duel test       прогнать тесты
HELP
    ;;
esac
