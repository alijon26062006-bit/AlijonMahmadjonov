# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID супер-администраторов через запятую
ADMIN_IDS=123456789

# База данных.
# MVP (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./cargo.db
# Продакшен (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://cargo:password@localhost:5432/cargo

# Заполнить БД демо-данными при первом запуске (true/false)
SEED_ON_START=true
