# ═══════════════════════════════════════════════════════════════
#  Настройки панели. Скопируйте в .env и заполните.
#  После изменения: systemctl restart averix
#  Что ещё не настроено — видно в Админке → «Готовность».
# ═══════════════════════════════════════════════════════════════

# ── Основное ───────────────────────────────────────────────
BRAND_NAME=Averix
# Длинная случайная строка: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_PATH=data/hosting.db
CURRENCY=USD
# Этот email при регистрации сразу получает права администратора
ADMIN_EMAIL=
# Адрес сайта. Должен открываться из интернета: сюда серверы клиентов шлют графики памяти
PUBLIC_URL=https://my.example.com
# true — куки только по HTTPS (обязательно в продакшене)
COOKIE_SECURE=true
# Через сколько дней после окончания оплаты сервер выключается
GRACE_DAYS=3
# Сколько серверов может держать клиент, пока вы не подтвердили его аккаунт в админке
NEW_USER_SERVER_LIMIT=1

# ── Серверы и DNS: Hetzner Cloud ───────────────────────────
# demo — всё симулируется; hetzner — настоящие серверы в вашем проекте Hetzner
VPS_PROVIDER=hetzner
DNS_PROVIDER=hetzner
# Hetzner Console → проект → Security → API tokens → Generate (Read & Write)
HETZNER_TOKEN=
# Неймсерверы, которые прописываются доменам (по умолчанию — Hetzner)
# NAMESERVERS=hydrogen.ns.hetzner.com,oxygen.ns.hetzner.com,helium.ns.hetzner.de

# ── Домены: ResellerClub ───────────────────────────────────
# demo — домены не регистрируются по-настоящему; resellerclub — настоящая регистрация
REGISTRAR=resellerclub
# Панель ResellerClub → Settings → API: Reseller ID и API key.
# Там же добавьте IP-адрес вашего сервера в список разрешённых!
RESELLERCLUB_USER_ID=
RESELLERCLUB_API_KEY=
# Клиент (Customer) в панели ResellerClub, на которого регистрируются домены.
# Создайте его один раз: Customers → Add Customer, номер — Customer ID.
RESELLERCLUB_CUSTOMER_ID=
# true — тестовый сервер ResellerClub (деньги не списываются). Проверьте и поставьте false
RESELLERCLUB_TEST=true

# ── Приём оплаты ───────────────────────────────────────────
# false в продакшене! true — кнопка «Пополнить» зачисляет деньги без оплаты
DEMO_PAYMENTS=false
# Клиент переводит деньги и отправляет заявку, вы подтверждаете в админке
PAYMENT_METHODS=Алиф Моби,Душанбе Сити,Корти Милли
# Реквизиты; \n — перенос строки
PAYMENT_INSTRUCTIONS=Переведите сумму на карту 0000 0000 0000 0000 (получатель: Имя Фамилия).\nВ комментарии к переводу укажите ваш email.

# ── Уведомления ────────────────────────────────────────────
# Вам в Telegram: новые клиенты, заказы, заявки на оплату, ошибки.
# Бот: @BotFather → /newbot. Chat ID: напишите боту и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — там будет "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Письма клиентам (создание сервера, пополнение, напоминания об оплате)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ── Компания и поддержка (документы, подвал сайта, письма) ─
COMPANY_NAME=
# Реквизиты: ИНН, адрес, банк; \n — перенос строки
COMPANY_DETAILS=
SUPPORT_TELEGRAM=
SUPPORT_EMAIL=
SUPPORT_PHONE=
