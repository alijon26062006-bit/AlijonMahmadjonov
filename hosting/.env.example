# Настройки хостинг-панели AlijonHost. install.sh копирует этот файл в
# <корень репозитория>/.env и сам генерирует DB_PASSWORD/SESSION_SECRET —
# остальное можно оставить как есть для первого запуска и поправить позже.
#
# Секреты для root-воркера (MYSQL_ADMIN_PASSWORD, CLOUDFLARE_API_TOKEN и т.п.)
# живут ОТДЕЛЬНО в /etc/hosting/worker.env (создаёт install.sh, доступен
# только root, 0600) — веб-процесс панели их никогда не читает.

APP_ENV=production
APP_URL=https://panel.diyorhost.com
PANEL_NAME=AlijonHost

# ── Домен ────────────────────────────────────────────────────────────────
# Единственное место, откуда домен берётся во всей кодовой базе.
# Поддомены клиентов будут вида <slug>.diyorhost.com. Сменить домен —
# поменять эту переменную и перезапустить install.sh, больше нигде править не нужно.
HOSTING_ROOT_DOMAIN=diyorhost.com
HOSTING_SERVER_IP=
HOSTING_SSH_PORT=22

# Порты, которые firewall должен оставить открытыми ПОМИМО 80/443/SSH — например,
# если на этом же сервере уже крутится что-то своё. Через запятую: 3005,8080.
# Опубликованные наружу порты Docker install.sh находит и добавляет сюда сам.
HOSTING_EXTRA_TCP_PORTS=

# ── Пути (обычно трогать не нужно) ──────────────────────────────────────
HOSTING_ROOT=/opt/hosting
HOSTING_USERS_ROOT=/home/hosting
NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
FPM_POOL_DIR=/etc/php/8.3/fpm/pool.d
LOG_DIR=/var/log/hosting
FPM_LISTEN=/run/php/{user}.sock
PHP_VERSIONS=8.3

# ── Панельная база данных (MariaDB, НЕ SQLite в production) ─────────────
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hosting_panel
DB_USERNAME=hosting_panel
DB_PASSWORD=

# ── Тарифы и регистрация ─────────────────────────────────────────────────
DEFAULT_PLAN=start
REGISTRATION=open
UPLOAD_MAX_MB=64

# ── Telegram Mini App ─────────────────────────────────────────────────────
# Токен бота от @BotFather — нужен и для входа через Mini App (проверка
# initData), и для алертов monitor.sh (см. TELEGRAM_ADMIN_CHAT_ID ниже,
# читается напрямую bash-скриптами, не через Config.php).
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — нужно кнопке «Войти через Telegram» на публичной главной.
# setup.sh заполняет его сам, узнав у Telegram по токену.
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=

# ── Сессии панели ──────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_TTL_SECONDS=1209600

# ── ACME / SSL ─────────────────────────────────────────────────────────
ACME_EMAIL=

# ── Cloudflare ─────────────────────────────────────────────────────────
# HOSTING_BEHIND_CLOUDFLARE=true — install.sh (и её ежедневный таймер) будет
# держать в nftables allowlist актуальные IP-диапазоны Cloudflare для 80/443
# (см. scripts/update-cloudflare-firewall.sh — использует ТОЛЬКО публичные
# ips-v4/ips-v6 эндпоинты Cloudflare, токен для этого не нужен).
# CLOUDFLARE_API_TOKEN/CLOUDFLARE_ZONE_ID зарезервированы под будущую
# автоматизацию wildcard-сертификата через DNS-01 — сейчас NOT IMPLEMENTED,
# см. SECURITY_CHECKLIST.md. Пока wildcard SSL выпускается вручную один раз
# (шаг напечатает install.sh) и продлевается certbot renew по таймеру.
HOSTING_BEHIND_CLOUDFLARE=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Резервные копии ────────────────────────────────────────────────────
# BACKUP_PROVIDER — имя настроенного rclone remote (rclone config).
# Пусто = бэкапы только локально в BACKUP_DIR (см. README — это НЕ
# рекомендуется для боевой эксплуатации, см. спецификацию BACKUPS).
BACKUP_PROVIDER=
BACKUP_BUCKET=hosting-backups
BACKUP_DIR=/opt/hosting/backups
