# ── Основное ───────────────────────────────────────────────
BRAND_NAME=AM Cloud
# Длинная случайная строка: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Путь к базе (SQLite)
DATABASE_PATH=data/hosting.db
# Валюта цен (символ)
CURRENCY=$
# Email, который при регистрации автоматически получает права администратора
ADMIN_EMAIL=
# true — куки только по HTTPS (обязательно в продакшене)
COOKIE_SECURE=false

# ── Провайдер VPS ─────────────────────────────────────────
# demo     — симуляция (для показа и разработки)
# proxmox  — реальные виртуалки на вашем Proxmox VE
VPS_PROVIDER=demo
PROXMOX_URL=https://pve.example.com:8006
PROXMOX_NODE=pve
# API-токен вида user@pam!tokenid=uuid (Datacenter → Permissions → API Tokens)
PROXMOX_TOKEN=
# ID шаблонов (VM templates) с cloud-init и qemu-guest-agent, через запятую os=vmid
PROXMOX_TEMPLATES=ubuntu-24.04=9000,debian-12=9001,almalinux-9=9002
PROXMOX_VERIFY_TLS=true
# Пул публичных IP для новых серверов (CIDR/шлюз)
PROXMOX_IP_POOL=203.0.113.10-203.0.113.250
PROXMOX_GATEWAY=203.0.113.1
PROXMOX_BRIDGE=vmbr0

# ── DNS ────────────────────────────────────────────────────
# demo     — записи хранятся только в базе
# powerdns — записи публикуются на ваш PowerDNS Authoritative
DNS_PROVIDER=demo
POWERDNS_URL=http://127.0.0.1:8081
POWERDNS_API_KEY=
POWERDNS_SERVER_ID=localhost
NAMESERVERS=ns1.amcloud.example,ns2.amcloud.example
