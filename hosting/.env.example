# ── Основное ───────────────────────────────────────────────
BRAND_NAME=AM Cloud
# Длинная случайная строка: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_PATH=data/hosting.db
CURRENCY=USD
# Email, который при регистрации сразу получает права администратора
ADMIN_EMAIL=
# true — куки только по HTTPS (обязательно в продакшене)
COOKIE_SECURE=false
# Публичный адрес панели. Агент на серверах клиентов отправляет сюда память и процессы,
# поэтому адрес должен открываться из интернета: https://my.example.com
PUBLIC_URL=http://127.0.0.1:8000
# true — в кабинете есть кнопка «Пополнить» без реальной оплаты (для показа).
# В продакшене поставьте false и подключите платёжную систему.
DEMO_PAYMENTS=true
# Через сколько дней после окончания оплаты сервер выключается
GRACE_DAYS=3

# ── Hetzner Cloud ─────────────────────────────────────────
# demo    — всё симулируется, ключ не нужен
# hetzner — настоящие серверы и DNS в вашем проекте Hetzner Cloud
VPS_PROVIDER=demo
DNS_PROVIDER=demo
# Hetzner Console → проект → Security → API tokens → Generate (права Read & Write).
# Один токен управляет и серверами, и DNS-зонами.
HETZNER_TOKEN=

# ── Домены ─────────────────────────────────────────────────
# Регистрация доменов пока демонстрационная: для настоящей нужен
# реселлерский договор с регистратором (ResellerClub, Openprovider и т.п.)
REGISTRAR=demo
