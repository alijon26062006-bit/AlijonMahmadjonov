# Скопируй в .env.mines (в корне репозитория) и заполни.
# Установщик minesbot/install.sh делает это сам.

# Токен от @BotFather: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAE_...

# Твой telegram id (@userinfobot), через запятую, если несколько. Необязательно.
ADMIN_IDS=

# Экономика
START_BALANCE=1000     # монет новичку
BONUS_AMOUNT=500       # бесплатный бонус
BONUS_HOURS=12         # раз во сколько часов
MIN_BET=10
MAX_BET=100000
MINES_COUNT=3          # мин на поле 5x5 по умолчанию (1-24)
HOUSE_EDGE=0.03        # комиссия казны: 0.03 = 3%

DATA_DIR=data          # где лежит mines.db
LOG_LEVEL=INFO
