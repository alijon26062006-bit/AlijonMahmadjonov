# AVERIX configuration.
#
# Copy to .env and fill in. NEVER commit the filled-in file, and never put a
# real secret in this example — every value here is a placeholder.
#
#   cp .env.example .env
#   openssl rand -hex 32        # use for each secret below
#
# The stack refuses to start with a missing or too-short secret rather than
# falling back to a default, which is the only safe behaviour.

# ── Where it lives ──────────────────────────────────────────────────────────
APP_ENV=production
AVERIX_DOMAIN=averix.dev
ACME_EMAIL=ops@averix.dev
APP_URL=https://averix.dev
API_URL=https://averix.dev
AVERIX_VERSION=1.0.0

# ── Secrets ─────────────────────────────────────────────────────────────────
# Both must be at least 32 bytes. Generate with: openssl rand -hex 32
# Changing COOKIE_SECRET signs everyone out. Changing DATA_ENCRYPTION_KEY
# makes stored third-party tokens unreadable — treat it as permanent.
COOKIE_SECRET=replace-with-openssl-rand-hex-32
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=averix
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=averix
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

# ── Cache and sessions ──────────────────────────────────────────────────────
REDIS_MAXMEMORY=256mb
REDIS_PREFIX=averix
SESSION_TTL=720h
SESSION_IDLE_TTL=168h

# ── File storage ────────────────────────────────────────────────────────────
# "filesystem" keeps uploads in a Docker volume — fine for one server, and the
# volume must be in your backups. "s3" is any S3-compatible provider
# (Cloudflare R2, Backblaze B2, Hetzner, MinIO).
S3_DRIVER=filesystem
STORAGE_ROOT=/data/storage
S3_PUBLIC_BASE_URL=https://averix.dev/api/v1/files
# S3_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=averix-private
# S3_PUBLIC_BUCKET=averix-public
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true
# S3_PUBLIC_BASE_URL=https://cdn.averix.dev

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_IMAGE_BYTES=10485760
MAX_FILE_BYTES=52428800
MAX_REQUEST_BYTES=57671680

# ── The analysis service ────────────────────────────────────────────────────
# Shared secret between the API and the Python service. It is not public and
# is never exposed to a browser.
AI_SERVICE_TOKEN=replace-with-openssl-rand-hex-32
AI_SERVICE_URL=http://ai:8000
# Without a model key the analysis service still runs: technologies are
# detected deterministically and every generated field reports that it was
# not generated. Nothing is invented.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ── GitHub ──────────────────────────────────────────────────────────────────
# Create an OAuth App: https://github.com/settings/developers
# Authorization callback URL: https://averix.dev/api/v1/github/callback
# Until these are set, the GitHub screens show a configuration state rather
# than a dead button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://averix.dev/api/v1/github/callback

# ── Payments ────────────────────────────────────────────────────────────────
# "manual" means bank transfer confirmed by an administrator — the transfer
# details are entered in the admin panel, not here. When a gateway is
# connected, set its keys and change the provider.
PAYMENTS_DEFAULT_PROVIDER=manual
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Without SMTP the product still works: verification tokens are issued and
# logged rather than sent, and the logs say so plainly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@averix.dev
MAIL_FROM_NAME=AVERIX

# ── Limits and behaviour ────────────────────────────────────────────────────
RATE_LIMIT_ANON=120
RATE_LIMIT_AUTH=600
RATE_LIMIT_WINDOW=1m
MAX_FAILED_LOGINS=8
LOCKOUT_DURATION=15m
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12
REQUEST_TIMEOUT=30s
SHUTDOWN_GRACE=20s

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
