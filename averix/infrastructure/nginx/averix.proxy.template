    # An upload limit at the edge, matching MAX_FILE_BYTES.
    client_max_body_size 55m;
    client_body_timeout 120s;

    location /api/ {
        limit_req zone=averix_api burst=40 nodelay;
        proxy_pass http://averix_api;
        proxy_http_version 1.1;

        # The WebSocket upgrade. Without these two headers the realtime
        # connection silently degrades into a reconnect loop.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $averix_connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
    }

    location = /health { proxy_pass http://averix_api/health; access_log off; }
    location = /ready  { proxy_pass http://averix_api/ready;  access_log off; }

    location / {
        proxy_pass http://averix_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
