# AVERIX — серверная часть сайта
# Ставится скриптом setup.sh в /etc/systemd/system/averix.service

[Unit]
Description=AVERIX backend
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=__SITE_DIR__
Environment="AVERIX_DATA_DIR=__DATA_DIR__"
Environment="AVERIX_SECURE_COOKIES=1"
Environment="AVERIX_SITE_URL=__SITE_URL__"
Environment="AVERIX_DEBUG=0"
Environment="PYTHONUNBUFFERED=1"

# Секреты — отдельным файлом, а не строками Environment здесь.
# Причины две. Первая: этот файл по умолчанию читают все пользователи
# системы, а /etc/averix.env кладётся с правами 600 для root.
# Вторая: setup.sh пересобирает этот файл из шаблона при повторном
# запуске, и вписанные сюда ключи потерялись бы молча.
#
# Минус перед путём означает «нет файла — не беда»: без секретов
# сайт работает как обычно, просто без писем и без Telegram.
#
#   AVERIX_SMTP_HOST=smtp.resend.com
#   AVERIX_SMTP_PORT=587
#   AVERIX_SMTP_USER=resend
#   AVERIX_SMTP_PASSWORD=ключ-от-сервиса
#   AVERIX_SMTP_FROM=noreply@ваш-домен
#   AVERIX_TELEGRAM_TOKEN=...
#   AVERIX_TELEGRAM_CHAT=...
EnvironmentFile=-/etc/averix.env
# Миграции — отдельным шагом до запуска рабочих процессов: если бы их
# применяли сами рабочие, два процесса взялись бы за одну миграцию разом.
ExecStartPre=__VENV__/bin/python -m app.cli migrate

# Два процесса: приложение теперь отдаёт весь сайт, а не только админку,
# и один рабочий стал бы узким местом. Записей в базу мало, чтения идут
# параллельно — SQLite в режиме WAL это выдерживает.
ExecStart=__VENV__/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8001 --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

# Закалка: процессу доступна на запись ровно одна папка — с данными
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
