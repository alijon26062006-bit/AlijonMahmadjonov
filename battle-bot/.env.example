# Токен от @BotFather
BOT_TOKEN=123456:AA...
# Username бота без @ — можно не задавать, бот определит сам при запуске
BOT_USERNAME=

# Канал, куда публикуются пары. ID вида -100...
# Бот должен быть админом канала с правом публикации.
CHANNEL_ID=-1001234567890
# Ссылка для кнопки «Подписаться» — можно не задавать,
# бот возьмёт её из данных канала
CHANNEL_URL=

# Кто может пользоваться админкой, через запятую
ADMIN_IDS=123456789

# Файл базы
DB_PATH=battle.db

# Время подведения итогов по МСК, по одному на раунд.
# Первое — дедлайн приёма заявок и итогов 1 раунда.
ROUND_TIMES=18:00,19:30,21:00,22:15,23:30

# Границы батла. Если к дедлайну заявок меньше MIN_PARTICIPANTS,
# батл не стартует: приём продлевается до следующего слота, голоса сохраняются.
MIN_PARTICIPANTS=4
MAX_PARTICIPANTS=512

# Голосовать может только подписчик канала
REQUIRE_SUBSCRIPTION=1
# Участвовать можно только с заполненным @username
REQUIRE_USERNAME=1

# Покупка голосов за Telegram Stars
PAID_VOTES=1
# формат: голоса:звёзды через запятую
VOTE_PACKS=1:15,5:60,10:100

# Призы за 1/2/3 место, в звёздах
PRIZES=1000,500,250

# Пауза между постами в канал, секунды
PUBLISH_DELAY=1.0

# Паузы, секунды
DM_DELAY=0.05

# Таблица премиум-эмодзи «символ -> emoji_id».
# Файла нет -> используются обычные эмодзи.
PREMIUM_EMOJI_FILE=premium_emoji.json
