# ── Токен бота ─────────────────────────────────────────────
# Получить у @BotFather в Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBB-CCCC

# Твой Telegram user id (узнать у @userinfobot).
# Бот отвечает ТОЛЬКО этим id. Через запятую, если их несколько.
ALLOWED_USER_IDS=123456789

# ── Ключи ──────────────────────────────────────────────────
# Распознавание голоса (Whisper): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Понимание смысла (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Необязательное ─────────────────────────────────────────
TZ=Asia/Dushanbe
DEFAULT_CURRENCY=TJS
DATA_DIR=data
ANTHROPIC_MODEL=claude-opus-5
WHISPER_MODEL=whisper-1
MAX_VOICE_SECONDS=300
LOG_LEVEL=INFO

# ═══ Математическая дуэль (duel/) ══════════════════════════
# Это отдельный бот. Заведи нового у @BotFather: /newbot
DUEL_BOT_TOKEN=987654321:AAAA-BBBB-CCCC

# Адрес, по которому Telegram откроет Mini App. Только https и только
# настоящий домен — на нём должен стоять сертификат (см. deploy/nginx.conf).
DUEL_PUBLIC_URL=https://duel.example.com

# Где слушать. За nginx достаточно локального адреса.
DUEL_HOST=127.0.0.1
DUEL_PORT=8081

# Сколько раз в секунду сервер рассылает состояние матча. 20 хватает глазу.
DUEL_TICK_HZ=20

# Отладка без Telegram: подпись не проверяется. На боевом сервере — не включать.
DUEL_DEV_MODE=0
