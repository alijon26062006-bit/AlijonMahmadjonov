# ── Токен бота ─────────────────────────────────────────────
# Получить у @BotFather в Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:AAAA-BBBB-CCCC

# Твой Telegram user id (узнать у @userinfobot).
# Бот отвечает ТОЛЬКО этим id. Через запятую, если их несколько.
ALLOWED_USER_IDS=123456789

# ── Ключи ──────────────────────────────────────────────────
# Распознавание голоса (Whisper): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Понимание смысла (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Необязательное ─────────────────────────────────────────
TZ=Asia/Dushanbe
DEFAULT_CURRENCY=TJS
DATA_DIR=data
ANTHROPIC_MODEL=claude-opus-5
WHISPER_MODEL=whisper-1
MAX_VOICE_SECONDS=300
LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════
# Счётчик товаров (папка counter/, инструкция в SCHETCHIK.md).
# Ему нужен ТОЛЬКО токен — ни OpenAI, ни Anthropic не используются.
# ══════════════════════════════════════════════════════════════
COUNTER_BOT_TOKEN=123456789:AAAA-BBBB-CCCC

# Пусто — бот отвечает всем. Впиши свой id (узнать у @userinfobot),
# чтобы отвечал только тебе. Через запятую, если вас несколько.
COUNTER_ALLOWED_USER_IDS=

VOSK_MODEL_PATH=models/vosk-ru
COUNTER_UNIT=шт
COUNTER_MAX_AMOUNT=1000000
COUNTER_DUPLICATE_WINDOW=8
COUNTER_DATA_DIR=data
