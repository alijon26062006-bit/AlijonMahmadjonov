# Nginx reverse proxy for the Django app, served by gunicorn over a unix socket.
# Adjust server_name and paths, then symlink into /etc/nginx/sites-enabled/.

server {
    listen 80;
    server_name your-domain.tj;

    location /static/ {
        alias /var/www/esim-store-django/staticfiles/;
    }

    location /media/ {
        alias /var/www/esim-store-django/media/;
    }

    location / {
        proxy_pass http://unix:/var/www/esim-store-django/gunicorn.sock:;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 10M;
}
