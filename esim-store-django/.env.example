# Copy to .env and fill in real values there. .env is gitignored - real
# secrets are never committed or pushed to GitHub.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Comma-separated list, e.g. alijondev.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite (zero-setup, fine for small deployments) or postgresql or mysql
DB_ENGINE=sqlite
DB_NAME=esim_store
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# ---------------------------------------------------------------------------
# Zadarma API (my.zadarma.com -> Интеграции -> Ключи и API). Server-side only.
# ---------------------------------------------------------------------------
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# WebRTC support widget key (Интеграции -> WebRTC tab) - public, safe for the browser.
ZADARMA_WIDGET_KEY=

# ---------------------------------------------------------------------------
# Airalo Partner API (partners.airalo.com). Server-side only.
# ---------------------------------------------------------------------------
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
AIRALO_BASE_URL=https://partners-api.airalo.com

PAYMENT_INSTRUCTIONS="Переведите точную сумму заказа на карту 0000 0000 0000 0000 (Получатель) и загрузите скриншот чека."
SITE_NAME=EasySIM
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=

MAX_RECEIPT_SIZE_MB=5
