# Токен главного бота (фабрики). Получить у @BotFather
MOTHER_BOT_TOKEN=

# Каждый пользователь приносит свой ключ ИИ (1) или платит владелец фабрики (0)
REQUIRE_OWN_KEY=1

# Ключ Anthropic владельца фабрики.
# Нужен только при REQUIRE_OWN_KEY=0. При REQUIRE_OWN_KEY=1 можно оставить пустым.
ANTHROPIC_API_KEY=

# Модель, которая собирает и правит сценарии ботов
ANTHROPIC_MODEL=claude-opus-5

# Модель, которая отвечает пользователям внутри созданных ботов
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Модели OpenAI для тех, кто принёс ключ ChatGPT
OPENAI_MODEL=gpt-4o
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# Ключ шифрования чужих токенов и ключей в базе.
# Сгенерировать: python -m botfactory.crypto
FERNET_KEY=

# Файл базы данных
DB_PATH=data/factory.db

# Название проекта (как фабрика представляется людям)
BRAND_NAME=Bot Factory

# Сколько ботов может создать один человек
MAX_BOTS_PER_USER=3

# Лимит ответов ИИ на одного бота в месяц. Считается только когда платит
# владелец фабрики (REQUIRE_OWN_KEY=0). Со своим ключом лимита нет.
AI_MONTHLY_LIMIT=500

# Сколько последних реплик помнит ИИ в диалоге
AI_HISTORY_LIMIT=10

# ID администраторов через запятую (необязательно)
ADMIN_IDS=
