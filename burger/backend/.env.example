# Пароль в админку. Обязательно смените перед запуском.
ADMIN_PASSWORD=придумайте-длинный-пароль

# Ключ подписи входа. Любая длинная случайная строка.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Бот, который присылает заказы. Токен у @BotFather.
TG_TOKEN=
# Куда слать: ваш id у @userinfobot или id группы
TG_ADMIN_CHAT=

# Адрес сайта снаружи — нужен для кнопки «Открыть панель» у курьеров
# и для адреса вебхука Telegram. Пример: https://theburger.tj
PUBLIC_URL=

# Секретный кусок адреса, куда Telegram шлёт нажатия кнопок курьеров.
# Любая случайная строка: python3 -c "import secrets; print(secrets.token_hex(8))"
TG_HOOK_SECRET=

# Адреса, откуда разрешено обращаться к API (через запятую).
# Пример: https://theburger.tj,https://alijon26062006-bit.github.io
ALLOWED_ORIGINS=*
