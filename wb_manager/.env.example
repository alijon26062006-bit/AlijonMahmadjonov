# Пример настроек. Скопируйте в .env и заполните. Реальные значения в git не попадают.

# ── Логи ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Telegram-бот ───────────────────────────────────────────
# Получить у @BotFather: /newbot
TELEGRAM_BOT_TOKEN=

# ── Фоновый анализ (worker) ────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_STALE_SECONDS=300

# ── База данных ────────────────────────────────────────────
DATABASE_URL=mysql+aiomysql://wbm:ПАРОЛЬ@mysql:3306/wbm?charset=utf8mb4

# ── Безопасность ───────────────────────────────────────────
# Ключ шифрования токенов WB. Создать: python -m wbm.security.keygen
# Смена ключа: FERNET_KEYS=новый,старый (старый нужен, чтобы прочитать прежние токены).
FERNET_KEYS=

# ── Текст отчёта (Claude) ──────────────────────────────────
# Ключ: https://console.anthropic.com/settings/keys. Пусто — отчёт по шаблонам, без Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина размышлений: low | medium | high. Для пересказа готовых цифр хватает low.
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT=120

# ── Wildberries API ────────────────────────────────────────
# true — работать с песочницей WB (нужен тестовый токен), false — с боевым API.
WB_SANDBOX=false
# Таймауты запросов к WB, секунды.
WB_TIMEOUT_CONNECT=10
WB_TIMEOUT_READ=60
# Повторы при ошибках сервера WB (5xx) и сбоях сети.
WB_MAX_RETRIES=4
# Повторы при ответе 429 «слишком много запросов».
WB_MAX_RATE_LIMIT_RETRIES=5
# Пауза между повторами: 1 с, 2 с, 4 с … но не больше WB_BACKOFF_MAX.
WB_BACKOFF_BASE=1
WB_BACKOFF_MAX=30
# Сколько секунд один запрос может ждать своей очереди из-за лимитов WB.
WB_MAX_WAIT=300
# Сколько запросов к WB одновременно на один магазин.
WB_MAX_CONCURRENCY=4
