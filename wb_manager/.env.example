# Пример настроек. Скопируйте в .env и заполните. Реальные значения в git не попадают.

# ── Логи ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Wildberries API ────────────────────────────────────────
# true — работать с песочницей WB (нужен тестовый токен), false — с боевым API.
WB_SANDBOX=false
# Таймауты запросов к WB, секунды.
WB_TIMEOUT_CONNECT=10
WB_TIMEOUT_READ=60
# Повторы при ошибках сервера WB (5xx) и сбоях сети.
WB_MAX_RETRIES=4
# Повторы при ответе 429 «слишком много запросов».
WB_MAX_RATE_LIMIT_RETRIES=5
# Пауза между повторами: 1 с, 2 с, 4 с … но не больше WB_BACKOFF_MAX.
WB_BACKOFF_BASE=1
WB_BACKOFF_MAX=30
# Сколько секунд один запрос может ждать своей очереди из-за лимитов WB.
WB_MAX_WAIT=300
# Сколько запросов к WB одновременно на один магазин.
WB_MAX_CONCURRENCY=4
