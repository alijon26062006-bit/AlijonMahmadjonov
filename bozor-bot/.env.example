# ─── Скопируйте в .env и заполните ───────────────────────────

# Telegram (обязательно)
BOT_TOKEN=123456:AA...                 # от @BotFather (/newbot)
BOT_USERNAME=my_bozor_bot              # без @
MINIAPP_SHORT_NAME=app                 # short name из /newapp

# Канал и модерация (обязательно)
CHANNEL_ID=-1001234567890              # канал публикаций, бот — админ
CHANNEL_USERNAME=my_bozor_channel      # для ссылок t.me/<username>/<msg>
ADMIN_CHAT_ID=-1009876543210           # приватная группа модерации
STORAGE_CHAT_ID=-1005555555555         # приватный чат-хранилище фото с сайта
ADMIN_IDS=111111111,222222222          # tg_id админов через запятую

# Адреса
DOMAIN=bozor.duckdns.org               # для HTTPS через Caddy (бесплатный поддомен подойдёт)
WEBAPP_URL=https://example.com         # Mini App / сайт (HTTPS обязателен для TG)
API_PUBLIC_URL=https://example.com     # публичный адрес API (пусто = same-origin)
CORS_ORIGINS=https://example.com

# Безопасность
JWT_SECRET=замените-на-48-случайных-символов

# База (для docker-compose менять не нужно)
POSTGRES_USER=bozor
POSTGRES_PASSWORD=поменяйте-пароль
POSTGRES_DB=bozor

# Проверка номеров
# Расшифровка VIN по открытой базе NHTSA (США): бесплатно, без ключа.
# false — остаются локальные проверки: контрольная сумма, год, марка по WMI.
VIN_DECODE_ENABLED=true
VIN_API_TIMEOUT=6
# Сколько одобренных объявлений должны сойтись, чтобы связка IMEI → модель
# начала подсказывать. 1 — площадка учится с первого же одобрения.
TAC_MIN_CONFIRMATIONS=1

# Бизнес
TJS_PER_USD=10.9
DAILY_LISTING_LIMIT=3
ACTIVE_LISTING_LIMIT=10
LISTING_TTL_DAYS=30
