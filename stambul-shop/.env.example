# ─────────── Магазин ───────────
SHOP_NAME=Stambul Shop
SHOP_TAGLINE=Одежда, обувь и всё для дома. Доставка по Казахстану
SUPPORT_USERNAME=

# ─────────── Telegram ───────────
# Бот служебный: присылает коды подтверждения и сообщения о заказах.
BOT_TOKEN=
BOT_USERNAME=stambul_shop_bot
# Личные id владельцев через запятую — источник правды о правах
ADMIN_IDS=
# Приватная группа, куда падают заказы (необязательно: они приходят и в личку)
ADMIN_CHAT_ID=0
# Приватный чат-хранилище фотографий товаров — обязателен для загрузки с сайта
STORAGE_CHAT_ID=0
# Канал витрины с новинками (необязательно)
CHANNEL_ID=0
CHANNEL_USERNAME=

# ─────────── Адреса ───────────
DOMAIN=
SITE_URL=http://localhost:5173
API_PUBLIC_URL=
CORS_ORIGINS=http://localhost:5173

# ─────────── Вход ───────────
JWT_SECRET=
# Вход через Google. Ключ берётся в console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID → Web application.
# В «Authorized JavaScript origins» впишите адрес сайта.
GOOGLE_CLIENT_ID=
# Закрытый каталог не попадает в поиск Google и открывается у друга стеной
# входа. 0 — смотреть можно всем, вход нужен в корзине. 1 — закрыть сразу.
REQUIRE_AUTH_TO_BROWSE=0

# ─────────── Почта ───────────
# Письма о заказах. Без этого работают только сообщения в Telegram.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=1
MAIL_FROM=

# ─────────── Порты (чтобы не спорить с другими проектами) ───────────
API_PORT=8010
WEB_PORT=8100

# ─────────── Базы ───────────
POSTGRES_USER=shop
POSTGRES_PASSWORD=поменяйте-пароль
POSTGRES_DB=shop

# ─────────── Деньги ───────────
CURRENCY=KZT
CURRENCY_SIGN=₸
# Курс нужен только для пересчёта закупки; цены магазина ведутся в тенге
KZT_PER_USD=500

# ─────────── Доставка ───────────
DELIVERY_CITY_PRICE=1500
DELIVERY_COUNTRY_PRICE=2500
# Бесплатно от этой суммы, 0 — выключено
FREE_DELIVERY_FROM=30000
# Адрес самовывоза; пусто — самовывоза нет
PICKUP_ADDRESS=

# ─────────── Оплата (Kaspi) ───────────
KASPI_PHONE=
KASPI_NAME=
KASPI_LINK=

# ─────────── Ограничения ───────────
MAX_PHOTOS=10
CART_MAX_ITEMS=30
ORDER_MIN_TOTAL=0
