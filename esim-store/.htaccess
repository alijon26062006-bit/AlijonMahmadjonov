# Block direct access to secrets and internal folders.
<FilesMatch "^config\.local\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

RewriteEngine On
RewriteRule ^(includes|sql|data)/ - [F,L,NC]

# Sensible defaults
Options -Indexes
DirectoryIndex index.php
